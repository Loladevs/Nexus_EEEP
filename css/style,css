*{
  box-sizing:border-box
}

:root{
  --cream:#f8f3e7;
  --paper:#fffdf8;
  --ink:#26352f;
  --muted:#728078;
  --green:#5f826f;
  --green-dark:#365c4c;
  --green-soft:#dce9df;
  --yellow:#f3d58b;
  --orange:#e9a56f;
  --orange-soft:#f8dfc9;
  --blue:#b9d7d5;
  --line:#e5e0d4;
  --shadow:0 18px 45px rgba(46,65,55,.09);
  --radius:24px;
}

html{
  scroll-behavior:smooth
}

body{
  margin:0;
  background:var(--cream);
  color:var(--ink);
  font-family:"DM Sans",system-ui,sans-serif
}

button,
input,
textarea{
  font:inherit
}

button{
  cursor:pointer
}

.app-shell{
  min-height:100vh;
  display:flex
}

.sidebar{
  width:250px;
  background:rgba(255,253,248,.82);
  border-right:1px solid var(--line);
  padding:28px 18px 18px;
  display:flex;
  flex-direction:column;
  position:fixed;
  inset:0 auto 0 0;
  z-index:20
}

.brand{
  display:flex;
  align-items:center;
  gap:11px;
  padding:0 8px 28px
}

.brand-mark{
  width:40px;
  height:40px;
  border-radius:14px;
  background:linear-gradient(145deg,var(--green),#7da58e);
  color:#fff;
  display:grid;
  place-items:center;
  font-family:Fraunces,serif;
  font-size:22px;
  box-shadow:0 7px 16px rgba(61,92,75,.18)
}

.brand strong{
  display:block;
  font-family:Fraunces,serif;
  font-size:22px;
  line-height:1
}

.brand span{
  display:block;
  color:var(--muted);
  font-size:11px;
  margin-top:4px
}

.seduc-context{
  margin:-12px 8px 20px;
  padding:10px 9px;
  border:1px solid var(--line);
  border-radius:15px;
  background:#fffaf0
}

.seduc-context img{
  width:100%;
  max-height:34px;
  object-fit:contain;
  object-position:left center;
  display:block
}

.seduc-context small{
  display:block;
  color:var(--muted);
  font-size:8px;
  line-height:1.35;
  margin-top:6px
}

.main-nav{
  display:grid;
  gap:5px
}

.nav-item{
  border:0;
  background:transparent;
  color:#69766f;
  text-align:left;
  padding:12px 13px;
  border-radius:14px;
  display:flex;
  gap:11px;
  align-items:center;
  font-size:14px;
  transition:.2s
}

.nav-item span{
  width:18px;
  text-align:center;
  font-size:17px;
  color:#809087
}

.nav-item:hover{
  background:#f2eee3;
  color:var(--ink);
  transform:translateX(2px)
}

.nav-item.active{
  background:var(--green-soft);
  color:var(--green-dark);
  font-weight:700
}

.nav-item.active span{
  color:var(--green-dark)
}

.sidebar-bottom{
  margin-top:auto;
  display:grid;
  gap:5px
}

.privacy-note{
  margin:13px 4px 0;
  padding:13px;
  border:1px solid var(--line);
  border-radius:16px;
  background:#fffaf0;
  display:flex;
  gap:9px;
  align-items:flex-start
}

.tiny-lock{
  font-size:16px;
  color:var(--green-dark)
}

.privacy-note b{
  display:block;
  font-size:11px
}

.privacy-note small{
  display:block;
  color:var(--muted);
  font-size:10px;
  line-height:1.35;
  margin-top:3px
}

.main-content{
  margin-left:250px;
  width:calc(100% - 250px);
  min-height:100vh
}

.topbar{
  height:74px;
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 38px;
  background:rgba(248,243,231,.8);
  backdrop-filter:blur(12px);
  position:sticky;
  top:0;
  z-index:15
}

.crumb{
  font-size:13px;
  color:var(--muted)
}

.crumb span{
  margin:0 7px;
  color:#b1b7b0
}

.crumb strong{
  color:var(--ink)
}

.top-actions{
  display:flex;
  align-items:center;
  gap:10px
}

.icon-btn{
  width:40px;
  height:40px;
  border:1px solid var(--line);
  border-radius:50%;
  background:var(--paper);
  color:var(--green-dark);
  position:relative
}

.icon-btn i{
  position:absolute;
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--orange);
  right:9px;
  top:8px;
  border:2px solid var(--paper)
}

.profile-mini{
  border:0;
  background:transparent;
  display:flex;
  align-items:center;
  gap:8px;
  color:var(--ink);
  font-weight:700;
  font-size:13px
}

.profile-mini img{
  width:34px;
  height:34px;
  border-radius:50%;
  object-fit:cover;
  border:2px solid #fff;
  box-shadow:0 2px 8px rgba(0,0,0,.08)
}

.mobile-menu{
  display:none;
  border:0;
  background:none;
  font-size:22px
}

#viewContainer{
  padding:34px 38px 55px;
  max-width:1420px;
  margin:auto
}

.view{
  animation:rise .35s ease
}

@keyframes rise{
  from{
    opacity:0;
    transform:translateY(7px)
  }

  to{
    opacity:1;
    transform:none
  }
}

.hero{
  display:grid;
  grid-template-columns:1.3fr .7fr;
  gap:24px;
  margin-bottom:25px
}

.hero-copy{
  padding:35px 35px 32px;
  border-radius:30px;
  background:linear-gradient(
    135deg,
    #e0eadf 0%,
    #f8efd8 62%,
    #f9dfca 100%
  );
  position:relative;
  overflow:hidden;
  min-height:275px
}

.hero-copy:after{
  content:"";
  position:absolute;
  width:250px;
  height:250px;
  border-radius:50%;
  background:rgba(255,255,255,.28);
  right:-100px;
  top:-90px
}

.eyebrow{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.14em;
  color:var(--green-dark);
  font-weight:800
}

h1,
h2,
h3{
  margin:0;
  font-family:Fraunces,Georgia,serif;
  color:var(--ink)
}

.hero h1{
  font-size:43px;
  line-height:1.05;
  margin:10px 0 12px;
  max-width:610px
}

.hero p{
  color:#596961;
  max-width:600px;
  line-height:1.65;
  margin:0
}

.hero-photo{
  min-height:275px;
  border-radius:30px;
  overflow:hidden;
  position:relative;
  background:#c7d8d0
}

.hero-photo img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block
}

.photo-caption{
  position:absolute;
  left:16px;
  bottom:16px;
  background:rgba(255,253,248,.92);
  padding:9px 12px;
  border-radius:12px;
  font-size:11px;
  color:#526158
}

.hero-actions{
  display:flex;
  gap:10px;
  margin-top:22px;
  position:relative;
  z-index:2
}

.btn{
  border:0;
  border-radius:13px;
  padding:12px 17px;
  font-weight:700;
  font-size:13px;
  transition:.2s
}

.btn:hover{
  transform:translateY(-1px)
}

.btn-primary{
  background:var(--green-dark);
  color:white;
  box-shadow:0 7px 16px rgba(54,92,76,.18)
}

.btn-soft{
  background:rgba(255,255,255,.66);
  color:var(--green-dark);
  border:1px solid rgba(54,92,76,.12)
}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:end;
  margin:30px 0 14px
}

.section-title h2{
  font-size:23px
}

.section-title p{
  margin:0;
  color:var(--muted);
  font-size:12px
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:13px
}

.stat-card,
.card{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:20px;
  box-shadow:var(--shadow)
}

.stat-card{
  padding:18px
}

.stat-label{
  color:var(--muted);
  font-size:11px
}

.stat-value{
  font-family:Fraunces,serif;
  font-size:28px;
  margin:5px 0
}

.stat-foot{
  font-size:11px;
  color:var(--green-dark)
}

.dashboard-grid{
  display:grid;
  grid-template-columns:1.25fr .75fr;
  gap:16px;
  margin-top:16px
}

.card{
  padding:22px
}

.card h3{
  font-size:19px;
  margin-bottom:4px
}

.card-sub{
  font-size:12px;
  color:var(--muted);
  margin-bottom:16px
}

.progress{
  height:9px;
  background:#eee9dc;
  border-radius:20px;
  overflow:hidden
}

.progress span{
  height:100%;
  display:block;
  background:linear-gradient(
    90deg,
    var(--green),
    #88a98f
  );
  border-radius:20px
}

.journey{
  display:grid;
  gap:14px
}

.journey-row{
  display:flex;
  align-items:center;
  gap:12px
}

.journey-icon{
  width:38px;
  height:38px;
  border-radius:12px;
  display:grid;
  place-items:center;
  background:#f5ead5;
  font-size:17px
}

.journey-row b{
  font-size:13px
}

.journey-row small{
  display:block;
  color:var(--muted);
  font-size:10px;
  margin-top:2px
}

.comp-list{
  display:grid;
  gap:13px
}

.comp-head{
  display:flex;
  justify-content:space-between;
  font-size:12px;
  margin-bottom:6px
}

.comp-head span{
  color:var(--muted)
}

.pill{
  display:inline-flex;
  padding:6px 9px;
  border-radius:999px;
  font-size:10px;
  font-weight:800;
  background:var(--green-soft);
  color:var(--green-dark)
}

.pill.orange{
  background:var(--orange-soft);
  color:#9a6037
}

.pill.blue{
  background:#deeeee;
  color:#416d6a
}

.pill.yellow{
  background:#faedc7;
  color:#866a24
}

.opportunity-list{
  display:grid;
  gap:10px
}

.opportunity{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:13px;
  border:1px solid var(--line);
  border-radius:15px;
  background:#fffdf8
}

.opportunity:hover{
  border-color:#c7d6ca
}

.opp-main{
  display:flex;
  gap:11px;
  align-items:center
}

.opp-icon{
  width:40px;
  height:40px;
  border-radius:12px;
  display:grid;
  place-items:center;
  background:#e6efe7
}

.opp-main b{
  font-size:12px
}

.opp-main small{
  display:block;
  color:var(--muted);
  font-size:10px;
  margin-top:3px
}

.empty{
  padding:34px;
  text-align:center;
  color:var(--muted)
}

.page-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  margin-bottom:20px
}

.page-head h1{
  font-size:34px
}

.page-head p{
  margin:7px 0 0;
  color:var(--muted);
  font-size:13px
}

.profile-grid{
  display:grid;
  grid-template-columns:.8fr 1.2fr;
  gap:18px
}

.profile-card{
  display:flex;
  align-items:center;
  gap:16px
}

.profile-card img{
  width:82px;
  height:82px;
  border-radius:24px;
  object-fit:cover
}

.profile-card h2{
  font-size:25px
}

.profile-card p{
  margin:5px 0;
  color:var(--muted);
  font-size:12px
}

.info-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:9px;
  margin-top:18px
}

.info-box{
  background:#faf6eb;
  border-radius:13px;
  padding:12px
}

.info-box small{
  display:block;
  color:var(--muted);
  font-size:10px
}

.info-box b{
  font-size:12px
}

.competence-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px
}

.competence-card{
  padding:19px;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:20px
}

.competence-top{
  display:flex;
  justify-content:space-between;
  align-items:center
}

.competence-card h3{
  font-size:17px
}

.big-score{
  font-family:Fraunces,serif;
  font-size:31px;
  color:var(--green-dark);
  margin:15px 0 4px
}

.competence-card p{
  font-size:11px;
  color:var(--muted);
  line-height:1.5
}

.stage-banner{
  background:linear-gradient(
    120deg,
    #dce9df,
    #f7e5cf
  );
  padding:24px;
  border-radius:22px;
  display:flex;
  justify-content:space-between;
  gap:20px;
  align-items:center;
  margin-bottom:16px
}

.stage-banner h2{
  font-size:27px
}

.stage-banner p{
  margin:5px 0 0;
  color:#596961;
  font-size:12px
}

.stage-status{
  background:rgba(255,255,255,.7);
  padding:10px 13px;
  border-radius:13px;
  font-size:11px;
  font-weight:800;
  color:var(--green-dark)
}

.feedback{
  border-left:3px solid var(--orange);
  padding-left:13px;
  font-size:12px;
  line-height:1.6;
  color:#59655f
}

.table-wrap{
  overflow:auto
}

.table{
  width:100%;
  border-collapse:collapse;
  font-size:12px
}

.table th,
.table td{
  text-align:left;
  padding:12px;
  border-bottom:1px solid var(--line)
}

.table th{
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted)
}

.portfolio-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px
}

.project{
  overflow:hidden;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:20px
}

.project img{
  width:100%;
  height:150px;
  object-fit:cover
}

.project-body{
  padding:15px
}

.project h3{
  font-size:17px
}

.project p{
  font-size:11px;
  color:var(--muted);
  line-height:1.5
}

.project-meta{
  display:flex;
  gap:6px;
  flex-wrap:wrap
}

.notice-list{
  display:grid;
  gap:10px
}

.notice{
  padding:16px;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:16px;
  display:flex;
  gap:12px
}

.notice-icon{
  width:38px;
  height:38px;
  border-radius:12px;
  display:grid;
  place-items:center;
  background:#f4ead7
}

.notice b{
  font-size:12px
}

.notice p{
  margin:4px 0 0;
  font-size:11px;
  color:var(--muted);
  line-height:1.45
}

.request-box{
  display:grid;
  grid-template-columns:1fr auto;
  gap:10px;
  margin-bottom:18px
}

select,
input,
textarea{
  border:1px solid var(--line);
  background:#fffdf8;
  color:var(--ink);
  border-radius:13px;
  outline:none
}

select{
  padding:12px
}

input,
textarea{
  padding:12px
}

input:focus,
textarea:focus,
select:focus{
  border-color:#a7bdad;
  box-shadow:0 0 0 3px rgba(95,130,111,.08)
}

.settings{
  display:grid;
  gap:12px
}

.setting{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:15px 0;
  border-bottom:1px solid var(--line)
}

.setting:last-child{
  border-bottom:0
}

.setting b{
  font-size:13px
}

.setting small{
  display:block;
  color:var(--muted);
  margin-top:3px;
  font-size:10px
}

.switch{
  width:45px;
  height:25px;
  border-radius:20px;
  background:#ddd9cf;
  padding:3px;
  transition:.2s
}

.switch span{
  display:block;
  width:19px;
  height:19px;
  border-radius:50%;
  background:white;
  transition:.2s
}

.switch.on{
  background:var(--green)
}

.switch.on span{
  transform:translateX(20px)
}

.modal-backdrop{
  position:fixed;
  inset:0;
  background:rgba(38,53,47,.35);
  backdrop-filter:blur(6px);
  display:none;
  place-items:center;
  z-index:50;
  padding:18px
}

.modal-backdrop.show{
  display:grid
}

.modal{
  width:min(680px,100%);
  max-height:88vh;
  overflow:auto;
  background:var(--paper);
  border-radius:25px;
  padding:28px;
  position:relative;
  box-shadow:0 25px 70px rgba(30,45,38,.2)
}

.modal-close{
  position:absolute;
  right:17px;
  top:14px;
  width:34px;
  height:34px;
  border:0;
  border-radius:50%;
  background:#f2eee4;
  font-size:22px;
  color:var(--ink)
}

.toast{
  position:fixed;
  right:24px;
  bottom:24px;
  background:var(--green-dark);
  color:white;
  padding:13px 17px;
  border-radius:14px;
  font-size:12px;
  box-shadow:0 12px 30px rgba(20,50,38,.22);
  transform:translateY(25px);
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:80
}

.toast.show{
  transform:none;
  opacity:1
}

.ai-chat{
  display:grid;
  gap:14px
}

.ai-head{
  display:flex;
  gap:12px;
  align-items:center
}

.ai-orb{
  width:42px;
  height:42px;
  border-radius:14px;
  display:grid;
  place-items:center;
  background:linear-gradient(145deg,#dce9df,#f3d58b);
  color:var(--green-dark);
  font-size:19px
}

.ai-messages{
  height:300px;
  overflow:auto;
  padding:10px;
  border:1px solid var(--line);
  border-radius:17px;
  background:#faf6eb;
  display:grid;
  align-content:start;
  gap:9px
}

.msg{
  max-width:82%;
  padding:10px 12px;
  border-radius:13px;
  font-size:11px;
  line-height:1.5
}

.msg.ai{
  background:#e1ece3;
  justify-self:start
}

.msg.user{
  background:#f3dfc8;
  justify-self:end
}

.ai-input{
  display:grid;
  grid-template-columns:1fr auto;
  gap:8px
}

.timeline{
  display:grid;
  gap:0;
  position:relative
}

.timeline:before{
  content:"";
  position:absolute;
  left:17px;
  top:18px;
  bottom:18px;
  width:2px;
  background:#dfe5dd
}

.timeline-item{
  display:flex;
  gap:14px;
  position:relative;
  padding:9px 0
}

.timeline-dot{
  width:36px;
  height:36px;
  flex:0 0 36px;
  border-radius:50%;
  background:#e4eee5;
  display:grid;
  place-items:center;
  z-index:1;
  font-size:14px
}

.timeline-item b{
  font-size:12px
}

.timeline-item small{
  display:block;
  color:var(--muted);
  font-size:10px;
  margin-top:3px
}

.kpi{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px 0;
  border-bottom:1px solid var(--line)
}

.kpi:last-child{
  border-bottom:0
}

.kpi b{
  font-size:12px
}

.kpi span{
  color:var(--green-dark);
  font-weight:800;
  font-size:12px
}

@media(max-width:1100px){

  .hero{
    grid-template-columns:1fr
  }

  .hero-photo{
    min-height:220px
  }

  .stats{
    grid-template-columns:repeat(2,1fr)
  }

  .dashboard-grid{
    grid-template-columns:1fr
  }

  .competence-grid{
    grid-template-columns:repeat(2,1fr)
  }

  .portfolio-grid{
    grid-template-columns:repeat(2,1fr)
  }
}

@media(max-width:780px){

  .sidebar{
    transform:translateX(-100%);
    transition:.25s;
    box-shadow:10px 0 30px rgba(0,0,0,.08)
  }

  .sidebar.open{
    transform:none
  }

  .main-content{
    margin-left:0;
    width:100%
  }

  .topbar{
    padding:0 18px
  }

  .mobile-menu{
    display:block
  }

  #viewContainer{
    padding:24px 18px 45px
  }

  .hero h1{
    font-size:34px
  }

  .stats{
    grid-template-columns:1fr 1fr
  }

  .profile-grid{
    grid-template-columns:1fr
  }

